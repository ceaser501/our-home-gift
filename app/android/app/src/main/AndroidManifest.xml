<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 소셜 로그인이 끝난 뒤 앱으로 돌아오는 길.
                 로그인은 크롬 커스텀 탭에서 진행된다(구글이 앱 내장 웹뷰에서의 로그인을
                 막아둬서 웹뷰 안에서는 처리할 수 없다). 끝나면 아래 스킴 주소로 리다이렉트되는데,
                 이 등록이 있어야 안드로이드가 그 주소를 우리 앱에 넘겨준다.
                 없으면 로그인이 브라우저에서 끝나고 앱은 로그아웃 상태로 남는다.

                 scheme 값은 strings.xml의 custom_url_scheme이고 패키지명과 같다.
                 받는 쪽은 client/src/utils/deepLink.js. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 갤러리에서 기프티콘 후보를 찾기 위한 사진 접근.
         버전마다 이름이 다르다. 13(TIRAMISU)부터는 사진 전용 권한이 따로 생겼고,
         12 이하에서는 저장소 읽기 권한 하나로 사진까지 열린다.

         READ_MEDIA_VISUAL_USER_SELECTED는 14부터의 "선택한 사진만 허용"이다. 이때는
         사용자가 고른 몇 장만 보여서 폴더를 훑는다는 전제가 깨지는데, 그렇더라도 아무것도
         못 보는 것보다는 낫기 때문에 함께 받아둔다(화면에서 다르게 안내한다).

         셋 다 사용자가 거부할 수 있고, 거부해도 앱은 그대로 동작한다 — 사진을 직접 올리는
         길이 그대로 있다. 이 기능은 처음부터 선택이다. -->
    <!-- '매장 찾기'에서 가까운 순으로 보여주기 위한 위치.
         웹에서는 브라우저가 알아서 물어봤지만, 앱에서는 여기 적어두지 않으면 안드로이드가
         물어보지도 않는다. 그래서 팝업 없이 곧바로 실패하고, 사용자는 허용할 기회조차 없다.
         (요청 자체는 Capacitor가 대신 해준다 — BridgeWebChromeClient의 위치 권한 처리)

         정확한 위치까지 받는 이유는 '가까운 순 정렬'이 이 기능의 전부이기 때문이다.
         대략적 위치만으로는 도보 거리의 매장 순서가 뒤집힌다. 거부해도 앱은 그대로 돌고,
         매장 목록만 순서 없이 보여준다. 받은 좌표는 서버에 저장하지 않는다. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
</manifest>
