VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 네이버 로그인(선택 기능)을 켤 때만 필요. 네이버 개발자센터에서 발급받은 Client ID
# (비밀값 아님, 브라우저에 노출돼도 되는 값). 가격검색 기능과 같은 네이버 애플리케이션을
# 쓰면 그 앱의 Client ID를 그대로 넣으면 된다. Client Secret은 여기 넣지 말고
# `supabase secrets set NAVER_CLIENT_SECRET=...`로 Edge Function 쪽에만 전달할 것.
VITE_NAVER_CLIENT_ID=your-naver-client-id

# 주변 매장 상세에서 지도를 보여줄 때 필요한 카카오 JavaScript 키(선택).
# REST 키와 달리 브라우저 노출이 전제인 키라 여기 넣어도 된다(개발자센터에 등록한
# 사이트 도메인에서만 동작). 카카오 개발자센터 → 앱 키 → JavaScript 키.
# 안 넣으면 상세에서 지도만 빠지고 나머지 정보는 그대로 나온다.
VITE_KAKAO_JS_KEY=

# ⚠️ 테스트 전용. 값을 넣으면 로그인 화면 맨 아래에 "전체 데이터 초기화" 버튼이 생기고,
# 누르면 가족·기프티콘·가입계정이 전부 지워집니다. 실사용 배포 시에는 이 값을 비워두세요.
# (같은 값을 `supabase secrets set RESET_TOKEN=...`으로도 등록해야 동작합니다.)
VITE_RESET_TOKEN=
