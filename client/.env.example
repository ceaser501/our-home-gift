VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 네이버 로그인(선택 기능)을 켤 때만 필요. "네이버 로그인" 앱으로 발급받은 Client ID
# (비밀값 아님, 브라우저에 노출돼도 되는 값). 가격검색 기능이 쓰는 네이버 "검색" 앱과는
# 완전히 다른 앱/키이니 섞이지 않게 주의. Client Secret은 여기 넣지 말고
# `supabase secrets set NAVER_LOGIN_CLIENT_SECRET=...`로 Edge Function 쪽에만 전달할 것.
VITE_NAVER_LOGIN_CLIENT_ID=your-naver-login-client-id
