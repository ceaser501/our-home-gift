{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "es2024": true
  },
  "globals": {
    "__APP_VERSION__": "readonly",
    "__BUILD_DATE__": "readonly"
  },
  "rules": {
    "no-undef": "error",
    "no-use-before-define": ["error", { "functions": false, "classes": true, "variables": true }]
  },
  "overrides": [
    {
      "files": ["vite.config.js", "scripts/**"],
      "env": { "node": true }
    }
  ]
}
